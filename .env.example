# ==============================================================================
# Elesor Studio — Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
#
# IMPORTANTE:
# 1. Este archivo solo sirve como plantilla de referencia.
# 2. El sitio web es 100% estático (HTML/CSS/JS vainilla sin servidor backend obligatorio).
# 3. NUNCA coloques API keys privadas, contraseñas ni secretos en este archivo ni en el código público.
#
# Diferencia entre variables:
# - PUBLIC_*: Valores públicos accesibles en el navegador (URLs de tiendas, IDs de analítica opcionales).
# - SECRET_*: Claves secretas de servidor (solo para funciones serverless, webhook receivers o endpoints privados).
# ==============================================================================

# URLs públicas de descarga en Google Play Console (cuando las apps estén publicadas)
PUBLIC_GOOGLE_PLAY_URL_MIAU=
PUBLIC_GOOGLE_PLAY_URL_AVENTURA=

# Endpoint del formulario de contacto (por ejemplo: Formspree, Basin, Getform o función serverless)
CONTACT_FORM_ENDPOINT=

# Identificador de analítica web con respeto estricto a privacidad (solo si se implementa, p. ej. Plausible o Cloudflare Web Analytics)
ANALYTICS_ID=
